# Postgres session persistence (opt-in). See README → Persistence.
GG_DATABASE_URL=postgresql://gg:gg@localhost:5432/gg_agent
# Schema for gg-agent's tables (created on first connect). Default: gg_agent
# GG_DATABASE_SCHEMA=gg_agent
# Used only by `uv run pytest -m pg`.
GG_TEST_DATABASE_URL=postgresql://gg:gg@localhost:5432/gg_agent_test
# Stream answers as they are generated (default on). 0 = print when complete.
# GG_STREAM=1
